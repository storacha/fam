type EntriesCaveats struct {
  ID DID (rename "id")
  root Link
  pfx optional String
  gt optional String 
  gte optional String
  lt optional String
  lte optional String
  limit optional Int
}

type EntriesOk struct {
	results [Entry]
}

type Entry struct {
  key String
  value Link
}

type RootCaveats struct {
  ID DID (rename "id")
  timestamp ISO8601Date (rename "ts")
}

type RootOk struct {
  root Link
}
