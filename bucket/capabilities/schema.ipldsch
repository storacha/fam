type EntriesCaveats struct {
  ID DID (rename "id")
  root Link
  pfx optional String
  gt optional String 
  gte optional String
  lt optional String
  lte optional String
  limit optional Int
}

type EntriesOk struct {
	results [Entry]
}

type Entry struct {
  key String
  value Link
}

type RootCaveats struct {
  ID DID (rename "id")
  timestamp ISO8601Date (rename "ts")
}

type RootOk struct {
  root Link
}

type PutCaveats struct {
  ID DID (rename "id")
  root Link
  key String
  value Link
}

type PutOk struct {
  root Link
}

type DeleteCaveats struct {
  ID DID (rename "id")
  root Link
  key String
  value Link
}

type DeleteOk struct {
  root Link
}

type GetCaveats struct {
  ID DID (rename "id")
  root Link
  key String
}

type GetOk struct {
  value Link
}
